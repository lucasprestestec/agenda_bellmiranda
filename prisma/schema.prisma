generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Service {
  id           String        @id @default(cuid())
  slug         String        @unique
  name         String
  description  String
  durationMin  Int? // null = duration not set yet; not bookable online until it is
  priceCents   Int? // null = price not set yet; not bookable online until it is
  priceNote    String?
  tags         String? // comma-separated, e.g. "Especialidade"
  order        Int           @default(0)
  active       Boolean       @default(true)
  // Who performs this service — the external WhatsApp agent notifies this
  // person (not just the client) on confirmation/reminder. Null = no staff
  // copy is sent for this service.
  staffName    String?
  staffPhone   String?
  appointments Appointment[]
}

// status is one of "CONFIRMED" | "COMPLETED" | "CANCELLED" — see lib/studio.js
// (SQLite has no native enum type; kept as a plain String.)
model Appointment {
  id            String   @id @default(cuid())
  // Either a catalog service (serviceId set) or an ad-hoc one-off service
  // (serviceId null, custom* fields describe it) — never both unset.
  service       Service? @relation(fields: [serviceId], references: [id])
  serviceId     String?
  customServiceName String?
  customDurationMin Int?
  customPriceCents  Int?
  // Denormalized copy of service.staffPhone at write time (null for ad-hoc /
  // no-staff appointments, same as the service it came from). Exists solely
  // so the DB-level `appointment_no_overlap` exclusion constraint — added
  // via prisma/ensure-constraints.mjs, since Postgres EXCLUDE constraints
  // have no Prisma schema representation — can check for conflicts without
  // joining Service (exclusion constraints can't reference other tables).
  // Every code path that creates/reschedules/reassigns an appointment must
  // keep this in sync with service.staffPhone.
  staffPhone    String?
  clientName    String
  clientPhone   String
  note          String?
  wantsReminder Boolean  @default(true)
  date          String // YYYY-MM-DD (studio-local calendar day)
  startTime     String // HH:mm
  endTime       String // HH:mm
  status        String   @default("CONFIRMED")
  createdAt     DateTime @default(now())

  // Set once the corresponding WhatsApp message is sent — guards against
  // double-sends (cron re-runs, retries) and lets /admin show send status.
  confirmationSentAt DateTime?
  reminderSentAt     DateTime?

  @@index([date])
}

model BlockedSlot {
  id        String   @id @default(cuid())
  date      String // YYYY-MM-DD
  startTime String // HH:mm
  endTime   String // HH:mm
  reason    String?
  createdAt DateTime @default(now())
  // Null = blocks the whole studio (day off, holiday). Set = blocks only
  // that one staff member's schedule. No admin UI sets this yet — every
  // existing/new block stays studio-wide until one is added.
  staffPhone String?

  @@index([date])
}
