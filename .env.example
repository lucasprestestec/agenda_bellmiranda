# Postgres connection string (prisma/schema.prisma)
DATABASE_URL=

# Admin login — see README "Admin auth"
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# WhatsApp — see README "WhatsApp automation"
# "mock" (default) just logs what would be sent; switch to "meta" once the
# number is connected in Meta Business Manager.
WHATSAPP_PROVIDER=mock
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Shared secret Vercel Cron sends as `Authorization: Bearer <value>` —
# generate with `openssl rand -hex 32`.
CRON_SECRET=
