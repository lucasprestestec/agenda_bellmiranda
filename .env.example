# Postgres connection string (prisma/schema.prisma)
DATABASE_URL=

# Admin login — see README "Admin auth"
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# WhatsApp — see README "WhatsApp automation". Sending itself happens
# outside this app, in the external agent project (Evolution API) — this
# secret is what authenticates that agent against /api/agent/*.
# Generate with `openssl rand -hex 32`.
CRON_SECRET=
