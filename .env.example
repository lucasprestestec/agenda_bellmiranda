# Postgres connection string (prisma/schema.prisma)
DATABASE_URL=

# Admin login — see README "Admin auth"
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# WhatsApp — see README "WhatsApp automation". Sending itself happens
# outside this app, in the external agent project (Evolution API) — this
# secret is what authenticates that agent against /api/agent/*.
# Generate with `openssl rand -hex 32`.
CRON_SECRET=

# WhatsApp Business — Meta Embedded Signup (Admin → Mais → WhatsApp
# Business). Lets the admin connect a number already active in the
# WhatsApp Business App without disrupting it (Coexistence). These two
# are public identifiers used client-side to open Meta's own signup
# popup — never put the App Secret here or anywhere in this app; the
# authorization code the popup returns is exchanged for a token
# server-side, in a piece not built yet (see components/admin/WhatsAppConnect.jsx).
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_WHATSAPP_CONFIG_ID=
# Facebook JS SDK / Graph API version. Bump this if Meta deprecates the
# default baked into WhatsAppConnect.jsx.
NEXT_PUBLIC_META_SDK_VERSION=

# TEMPORARY — /admin/meta-review only, to produce the two demonstration
# videos Meta App Review requires (whatsapp_business_messaging and
# whatsapp_business_management). Meta's own TEST phone number / TEST WABA
# — never the real Bell Miranda number, which isn't on the Graph API at
# all (see README "WhatsApp automation"). Server-side only — these must
# NEVER get a NEXT_PUBLIC_ prefix. Delete these three vars, this page,
# lib/meta-review.js, and its two API routes once Meta approves the app.
META_REVIEW_ACCESS_TOKEN=
META_REVIEW_PHONE_NUMBER_ID=
META_REVIEW_WABA_ID=
